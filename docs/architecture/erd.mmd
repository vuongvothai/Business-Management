erDiagram

    SUPPLIER {
        bigint supplier_id PK
        string name "Tên nhà cung cấp"
        string identity_no "CCCD hoặc mã định danh"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        decimal usable_coffee_kg "Số cà phê hữu dụng còn lại (kg)"
        datetime created_at
        datetime updated_at
    }

    ROLE {
        bigint role_id PK
        string role_name UK "ADMIN, WEIGHER hoặc ACCOUNTANT"
    }

    USER {
        bigint user_id PK
        string full_name "Họ và tên người dùng"
        bigint role_id FK
        datetime created_at
        datetime updated_at
    }

    CUSTOMER {
        bigint customer_id PK
        string name "Tên khách hàng"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        datetime created_at
        datetime updated_at
    }

    ITEM {
        bigint item_id PK
        string name "Tên mặt hàng"
        string category "Phân loại mặt hàng"
        string unit "Đơn vị tính"
        decimal available_kg "Tồn kho khả dụng (kg)"
        datetime created_at
        datetime updated_at
    }

    VEHICLE {
        bigint vehicle_id PK
        string license_plate UK "Biển số xe"
        boolean active "Còn hiển thị trong danh sách chọn"
        datetime created_at
        datetime updated_at
    }

    IMPORT_TICKET {
        bigint import_id PK
        bigint supplier_id FK
        bigint item_id FK
        bigint vehicle_id FK "Xe chọn từ danh sách, có thể null"
        string truck_license_plate "Biển số xe"
        string loading_warehouse "Kho bốc"
        string import_warehouse "Kho nhập"
        int number_of_bags "Tổng số bao, tự tính từ IMPORT_WEIGHT"
        decimal total_kg "Tổng khối lượng, tự tính từ IMPORT_WEIGHT"
        decimal tare_weight "Trừ bì"
        string sample_test_result "Mẫu thử"
        decimal moisture_percent "Tỷ lệ độ ẩm"
        decimal impurity_percent "Tỷ lệ tạp chất"
        decimal purchase_price_per_kg "Đơn giá mua"
        decimal market_price_per_kg "Giá thị trường"
        decimal market_difference_per_kg "Chênh lệch giá thị trường"
        decimal total_amount "Thành tiền"
        decimal total_deduction_amount "Tổng khấu trừ"
        string photo_url "Ảnh minh chứng"
        date import_date "Ngày nhập"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED hoặc CANCELLED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    IMPORT_WEIGHT {
        bigint weight_id PK
        bigint import_id FK
        decimal weight_kg "Khối lượng lần cân (kg)"
        tinyint bag_count "Số bao của lần cân"
        bigint created_by FK
        datetime created_at
    }

    PRICE_LOCK {
        bigint price_lock_id PK
        bigint supplier_id FK
        bigint item_id FK
        decimal locked_volume "Khối lượng chốt (kg)"
        decimal locked_price_per_kg "Giá chốt trên mỗi kg"
        decimal amount "Thành tiền, tự tính"
        date lock_date "Ngày chốt giá"
        string note "Ghi chú"
        string status "DRAFT hoặc CONFIRMED"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_TICKET {
        bigint export_id PK
        bigint customer_id FK
        bigint item_id FK
        decimal committed_volume "Khối lượng cam kết bán (kg)"
        decimal selling_price_per_kg "Giá bán trên mỗi kg"
        decimal market_price_per_kg "Giá thị trường trên mỗi kg"
        decimal market_difference_per_kg "Chênh lệch với giá thị trường"
        decimal avg_cost_per_kg "Giá vốn bình quân trên mỗi kg"
        decimal revenue "Doanh thu, tự tính"
        decimal estimated_profit "Lợi nhuận ước tính, tự tính"
        date export_date "Ngày chốt bán"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED, PARTIALLY_DELIVERED hoặc COMPLETED"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_DELIVERY {
        bigint delivery_id PK
        bigint export_id FK
        bigint vehicle_id FK "Xe chọn từ danh sách, có thể null"
        decimal delivered_volume "Khối lượng giao thực tế (kg)"
        date delivery_date "Ngày giao hàng"
        string truck_license_plate "Biển số xe"
        string loading_warehouse "Kho bốc"
        string import_warehouse "Kho nhập"
        string status "CONFIRMED hoặc CANCELLED"
        string note "Ghi chú lần giao"
        bigint created_by FK
        datetime created_at
    }

    EXPENSE {
        bigint expense_id PK
        decimal total_amount "Tổng tiền các khoản chi"
        date period_start "Ngày bắt đầu kỳ chi phí"
        date period_end "Ngày kết thúc kỳ chi phí"
        string note "Ghi chú kỳ chi phí"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPENSE_DETAIL {
        bigint expense_detail_id PK
        bigint expense_id FK
        string category_name "Tên danh mục chi phí"
        decimal amount "Số tiền của danh mục"
    }

    MARKET_PRICE {
        bigint market_price_id PK
        bigint item_id FK
        date price_date "Ngày áp dụng giá"
        decimal price_per_kg "Giá thị trường trên mỗi kg"
        string source "Nguồn giá"
        datetime fetched_at
    }

    CONSIGNMENT_TICKET {
        bigint consignment_id PK
        bigint customer_id FK "Khách gửi hàng"
        bigint item_id FK
        bigint vehicle_id FK "Xe chọn, có thể null"
        string truck_license_plate "Biển số xe snapshot"
        int number_of_bags "Tổng số bao"
        decimal gross_weight_kg "Trọng lượng có bì (kg)"
        decimal tare_weight_kg "Trọng lượng bì (kg)"
        decimal net_weight_kg "Trọng lượng thực tế (kg)"
        decimal moisture_percent "Độ ẩm (%)"
        decimal impurity_percent "Tạp chất (%)"
        decimal black_broken_ratio "Tỷ lệ đen/vỡ/sâu (%)"
        string screen_size "Cỡ sàng (R13, R16, R18...)"
        decimal standard_weight_kg "Trọng lượng quy chuẩn (kg), tự tính"
        decimal moisture_standard "Chuẩn độ ẩm (ex: 12.5%)"
        decimal impurity_standard "Chuẩn tạp chất (ex: 1%)"
        int free_storage_days "Miễn phí lưu kho X ngày đầu"
        decimal storage_fee_per_ton_month "Phí lưu kho/tấn/tháng sau miễn phí"
        decimal natural_loss_rate "Tỷ lệ hao hụt tự nhiên/tháng (%)"
        string photo_url "Ảnh minh chứng"
        date consignment_date "Ngày nhập gửi"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED, CANCELLED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    CONSIGNMENT_WEIGHT {
        bigint cw_id PK
        bigint consignment_id FK
        decimal weight_kg "Khối lượng lần cân (kg)"
        tinyint bag_count "Số bao"
        bigint created_by FK
        datetime created_at
    }

    CONSIGNMENT_BALANCE {
        bigint balance_id PK
        bigint customer_id FK "Khách hàng"
        bigint item_id FK
        decimal total_sent_kg "Tổng đã gửi (quy chuẩn)"
        decimal total_locked_kg "Tổng đã chốt giá"
        decimal total_withdrawn_kg "Tổng đã rút"
        decimal remaining_kg "Số dư còn lại, tự tính"
        datetime updated_at
    }

    CONSIGNMENT_PRICE_LOCK {
        bigint cpl_id PK
        bigint customer_id FK
        bigint consignment_id FK "Phiếu gửi gốc"
        bigint item_id FK
        decimal locked_volume "Khối lượng chốt (quy chuẩn)"
        datetime locked_at "Ngày giờ chốt đến phút/giây"
        decimal locked_price_per_kg "Đơn giá chốt"
        decimal gross_amount "Thành tiền gộp"
        decimal advance_deduction_amount "Đối trừ tạm ứng (gốc + lãi)"
        decimal net_amount "Số tiền thực nhận"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    ADVANCE_PAYMENT {
        bigint advance_id PK
        bigint customer_id FK
        bigint consignment_id FK "Phiếu gửi làm cơ sở"
        decimal advance_amount "Số tiền ứng"
        date advance_date "Ngày ứng"
        decimal interest_rate "Lãi suất/tháng (ex: 0.8%)"
        int max_advance_percent "Hạn mức ứng tối đa (%)"
        decimal market_price_at_advance "Giá thị trường tại thời điểm ứng"
        int interest_days "Số ngày tính lãi"
        decimal interest_amount "Tiền lãi phát sinh"
        decimal total_repayment "Tổng gốc + lãi"
        string status "ACTIVE, SETTLED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    FORWARD_CONTRACT {
        bigint fc_id PK
        bigint customer_id FK
        bigint item_id FK
        string contract_code "Mã hợp đồng"
        decimal committed_volume "Khối lượng cam kết (quy chuẩn)"
        decimal locked_price_per_kg "Đơn giá đã chốt"
        date delivery_deadline "Hạn chót giao hàng"
        decimal deposit_amount "Số tiền đặt cọc"
        decimal delivered_volume "Khối lượng đã giao"
        decimal remaining_volume "Khối lượng còn phải giao"
        string status "ACTIVE, COMPLETED, OVERDUE, CANCELLED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    FORWARD_CONTRACT_DELIVERY {
        bigint fcd_id PK
        bigint fc_id FK
        bigint consignment_weight_id FK "Phiếu cân thực tế"
        decimal delivered_volume "Khối lượng giao (quy chuẩn)"
        date delivery_date "Ngày giao"
        decimal excess_volume "Phần giao dư"
        string excess_handling "Cách xử lý dư: MARKET_PRICE, NEW_CONSIGNMENT"
        string note "Ghi chú"
        bigint created_by FK
        datetime created_at
    }

    CASH_LEDGER {
        bigint ledger_id PK
        bigint customer_id FK
        decimal total_advanced "Tổng tiền đã ứng"
        decimal total_interest "Tổng lãi phát sinh"
        decimal total_locked_amount "Tổng tiền hàng đã chốt phải trả"
        decimal total_deposit_paid "Tổng tiền cọc đã chi"
        decimal net_balance "Số dư ròng, tự tính"
        datetime updated_at
    }

