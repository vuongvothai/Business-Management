    IMPORT_WEIGHT {
        bigint weight_id PK
        bigint import_id FK
        decimal weight_kg "Khối lượng lần cân (kg)"
        tinyint bag_count "Số bao của lần cân mặc định là 2 có thể điều chỉnh trực tiếp."
        bigint created_by FK
        datetime created_at
    }

    PRICE_LOCK {
        bigint price_lock_id PK
        bigint supplier_id FK
        bigint item_id FK
        decimal locked_volume "Khối lượng chốt (kg)"
        decimal locked_price_per_kg "Giá chốt trên mỗi kg"
        decimal amount "Thành tiền, tự tính"
        date lock_date "Ngày chốt giá"
        string note "Ghi chú"
        string status "DRAFT hoặc CONFIRMED"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_TICKET {
        bigint export_id PK
        bigint customer_id FK
        bigint item_id FK
        decimal committed_volume "Khối lượng cam kết bán (kg)"
        decimal selling_price_per_kg "Giá bán trên mỗi kg"
        decimal market_price_per_kg "Giá thị trường trên mỗi kg"
        decimal market_difference_per_kg "Chênh lệch với giá thị trường"
        decimal avg_cost_per_kg "Giá vốn bình quân trên mỗi kg"
        decimal revenue "Doanh thu, tự tính"
        decimal estimated_profit "Lợi nhuận ước tính, tự tính"
        date export_date "Ngày chốt bán"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED, PARTIALLY_DELIVERED hoặc COMPLETED (Đã bỏ CANCELLED)"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_DELIVERY {
        bigint delivery_id PK
        bigint export_id FK
        decimal delivered_volume "Khối lượng giao thực tế (kg)"
        date delivery_date "Ngày giao hàng"
        string truck_license_plate "Biển số xe"
        string loading_warehouse "Kho bốc"
        string import_warehouse "Kho nhập"
        string status "CONFIRMED hoặc CANCELLED"
        string note "Ghi chú lần giao"
        bigint created_by FK
        datetime created_at
    }

    EXPENSE {
        bigint expense_id PK
        decimal total_amount "Tổng tiền các khoản chi"
        date period_start "Ngày bắt đầu kỳ chi phí"
        date period_end "Ngày kết thúc kỳ chi phí"
        string note "Ghi chú kỳ chi phí"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPENSE_DETAIL {
        bigint expense_detail_id PK
        bigint expense_id FK
        string category_name "Tên danh mục chi phí"
        decimal amount "Số tiền của danh mục"
    }

    MARKET_PRICE {
        bigint market_price_id PK
        bigint item_id FK
        date price_date "Ngày áp dụng giá"
        decimal price_per_kg "Giá thị trường trên mỗi kg"
        string source "Nguồn giá"
        datetime fetched_at
    }

