    WAREHOUSE ||--o{ INVENTORY_TRANSACTION : records
    ITEM ||--o{ INVENTORY_TRANSACTION : tracks
    USER ||--o{ INVENTORY_TRANSACTION : creates

    PAYMENT_VOUCHER ||--|{ PAYMENT_ALLOCATION : allocates
    USER ||--o{ PAYMENT_VOUCHER : creates

    EXPENSE ||--|{ EXPENSE_DETAIL : itemizes
    EXPENSE_CATEGORY ||--o{ EXPENSE_DETAIL : classifies
    USER ||--o{ EXPENSE : creates

    ITEM ||--o{ MARKET_PRICE : priced_at

