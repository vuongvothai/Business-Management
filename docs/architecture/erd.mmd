    SUPPLIER {
        bigint supplier_id PK
        string name "Tên nhà cung cấp"
        string identity_no "CCCD hoặc mã định danh"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        decimal usable_coffee_kg "Số cà phê hữu dụng còn lại (kg)"
        datetime created_at
        datetime updated_at
    }

    ROLE {
        bigint role_id PK
        string role_name UK "ADMIN, WEIGHER hoặc ACCOUNTANT"
    }

    USER {
        bigint user_id PK
        string full_name "Họ và tên người dùng"
        bigint role_id FK
        datetime created_at
        datetime updated_at
    }

    CUSTOMER {
        bigint customer_id PK
        string name "Tên khách hàng"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        datetime created_at
        datetime updated_at
    }

    ITEM {
        bigint item_id PK
        string name "Tên mặt hàng"
        string category "Phân loại mặt hàng"
        string unit "Đơn vị tính"
        decimal available_kg "Tồn kho khả dụng (kg)"
        datetime created_at
        datetime updated_at
    }
VEHICLE {
