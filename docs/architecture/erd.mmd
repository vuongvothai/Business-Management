    ITEM ||--o{ CONSIGNMENT_PRICE_LOCK : item_of
    USER ||--o{ CONSIGNMENT_PRICE_LOCK : creates

    CUSTOMER ||--o{ ADVANCE_PAYMENT : takes_advance
