
erDiagram

    SUPPLIER {
        bigint supplier_id PK
        string name "Tên nhà cung cấp"
        string identity_no "CCCD hoặc mã định danh"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        decimal usable_coffee_kg "Số cà phê hữu dụng còn lại (kg)"
        datetime created_at
        datetime updated_at
    }

    ROLE {
        bigint role_id PK
        string role_name UK "ADMIN, WEIGHER hoặc ACCOUNTANT"
    }

    USER {
        bigint user_id PK
        string full_name "Họ và tên người dùng"
        bigint role_id FK
        datetime created_at
        datetime updated_at
    }

    CUSTOMER {
        bigint customer_id PK
        string name "Tên khách hàng"
        string phone "Số điện thoại"
        string address "Địa chỉ"
        datetime created_at
        datetime updated_at
    }

    ITEM {
        bigint item_id PK
        string name "Tên mặt hàng"
        string category "Phân loại mặt hàng"
        string unit "Đơn vị tính"
        decimal available_kg "Tồn kho khả dụng (kg)"
        datetime created_at
        datetime updated_at
    }

    IMPORT_TICKET {
        bigint import_id PK
        bigint supplier_id FK
        bigint item_id FK
        int number_of_bags "Tổng số bao, tự tính từ IMPORT_WEIGHT"
        decimal total_kg "Tổng khối lượng, tự tính từ IMPORT_WEIGHT"
        decimal moisture_percent "Tỷ lệ độ ẩm (%)"
        decimal impurity_percent "Tỷ lệ tạp chất (%)"
        decimal purchase_price_per_kg
        decimal market_price_per_kg
        decimal market_difference_per_kg
        string photo_url "Ảnh minh chứng, không bắt buộc"
        date import_date "Ngày nhập"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED hoặc CANCELLED"
        bigint created_by FK
        datetime created_at
        datetime updated_at
    }

    IMPORT_WEIGHT {
        bigint weight_id PK
        bigint import_id FK
        decimal weight_kg "Khối lượng lần cân (kg)"
        tinyint bag_count "Số bao của lần cân: 1 hoặc 2"
        bigint created_by FK
        datetime created_at
    }

    PRICE_LOCK {
        bigint price_lock_id PK
        bigint supplier_id FK
        bigint item_id FK
        decimal locked_volume "Khối lượng chốt (kg)"
        decimal locked_price_per_kg "Giá chốt trên mỗi kg"
        decimal amount "Thành tiền, tự tính"
        date lock_date "Ngày chốt giá"
        string note "Ghi chú"
        string status "DRAFT hoặc CONFIRMED"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_TICKET {
        bigint export_id PK
        bigint customer_id FK
        bigint item_id FK
        decimal committed_volume "Khối lượng cam kết bán (kg)"
        decimal selling_price_per_kg "Giá bán trên mỗi kg"
        decimal market_price_per_kg "Giá thị trường trên mỗi kg"
        decimal market_difference_per_kg "Chênh lệch với giá thị trường"
        decimal avg_cost_per_kg "Giá vốn bình quân trên mỗi kg"
        decimal revenue "Doanh thu, tự tính"
        decimal estimated_profit "Lợi nhuận ước tính, tự tính"
        date export_date "Ngày chốt bán"
        date delivery_due_date "Ngày dự kiến giao"
        string note "Ghi chú"
        string status "DRAFT, CONFIRMED, PARTIALLY_DELIVERED, COMPLETED hoặc CANCELLED"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPORT_DELIVERY {
        bigint delivery_id PK
        bigint export_id FK
        decimal delivered_volume "Khối lượng giao thực tế (kg)"
        date delivery_date "Ngày giao hàng"
        string status "CONFIRMED hoặc CANCELLED"
        string note "Ghi chú lần giao"
        bigint created_by FK
        datetime created_at
    }

    EXPENSE {
        bigint expense_id PK
        decimal total_amount "Tổng tiền các khoản chi"
        date period_start "Ngày bắt đầu kỳ chi phí"
        date period_end "Ngày kết thúc kỳ chi phí"
        string note "Ghi chú kỳ chi phí"
        bigint created_by FK
        bigint updated_by FK
        datetime created_at
        datetime updated_at
    }

    EXPENSE_DETAIL {
        bigint expense_detail_id PK
        bigint expense_id FK
        string category_name "Tên danh mục chi phí"
        decimal amount "Số tiền của danh mục"
    }

    MARKET_PRICE {
        bigint market_price_id PK
        bigint item_id FK
        date price_date "Ngày áp dụng giá"
        decimal price_per_kg "Giá thị trường trên mỗi kg"
        string source "Nguồn giá"
        datetime fetched_at
    }

    ROLE ||--o{ USER : "gán"

    SUPPLIER ||--o{ IMPORT_TICKET : "cung cấp"
    ITEM ||--o{ IMPORT_TICKET : "được nhập"
    IMPORT_TICKET ||--|{ IMPORT_WEIGHT : "gồm"

    SUPPLIER ||--o{ PRICE_LOCK : "chốt giá"
    ITEM ||--o{ PRICE_LOCK : "được chốt"

    CUSTOMER ||--o{ EXPORT_TICKET : "nhận hàng"
    ITEM ||--o{ EXPORT_TICKET : "được xuất"
    EXPORT_TICKET ||--o{ EXPORT_DELIVERY : "giao nhiều lần"

    USER ||--o{ IMPORT_TICKET : "tạo"
    USER ||--o{ PRICE_LOCK : "tạo"
    USER ||--o{ EXPORT_TICKET : "tạo"
    USER ||--o{ EXPORT_DELIVERY : "ghi nhận"
    USER ||--o{ EXPENSE : "tạo"
    EXPENSE ||--|{ EXPENSE_DETAIL : "gồm"
    ITEM ||--o{ MARKET_PRICE : "có giá"
